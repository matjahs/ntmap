# Ntmap database (compose service ntmap-db)
NTMAP_DB_NAME=ntmap
NTMAP_DB_USER=ntmap
# Required — choose a local password; do not commit real values.
# Set BOTH to the same value (Compose loads .env; no password keys in docker-compose.yml).
NTMAP_DB_PASSWORD=
POSTGRES_PASSWORD=
NTMAP_HTTP_PORT=8080
MAX_OBJECTS_AT_ONE_LEVEL=100

# External NetBox REST API (required)
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=

# Homelab DNS (Docker Desktop often cannot resolve internal names without this)
DNS_SERVER=172.16.0.1

# Frontend backend path (usually leave as /data)
NTMAP_BACKEND_URI=/data
